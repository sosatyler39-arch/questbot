---
import WikiLayout from '../../../../../components/WikiLayout.astro';
import { getCollection } from 'astro:content';

// Looked up at request time via Astro.params rather than getStaticPaths'
// props — this page is on-demand rendered (see astro.config.mjs's
// output: 'server', needed so the site-lockdown middleware sees every
// request), and getStaticPaths is ignored for non-prerendered pages.
const { category, page, item } = Astro.params as { category: string; page: string; item: string };
const entries = await getCollection(
  'wiki',
  (e) => e.data.category === category && e.data.pageSlug === page && e.data.itemSlug === item,
);
const entry = entries[0];
if (!entry) return new Response('Not found', { status: 404 });
---
<WikiLayout title={entry.data.name}>
  <div class="wiki-item">
    <p><a href={`/elden-ring/wiki/${category}/${page}`}>&larr; {entry.data.pageTitle}</a></p>
    <h1>{entry.data.name}</h1>
    <p class="wiki-item-text">{entry.data.text}</p>
  </div>
</WikiLayout>
<style>
  .wiki-item {
    padding: 40px;
    max-width: 700px;
    margin: 0 auto;
  }
  .wiki-item-text {
    line-height: 1.6;
    white-space: pre-wrap;
  }
</style>
