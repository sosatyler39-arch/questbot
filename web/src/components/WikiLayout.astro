---
import Header from './Header.astro';
import SubTabs from './SubTabs.astro';
import '../styles/theme.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Questbot — {title}</title>
  </head>
  <body>
    <Header />
    <SubTabs active="wiki" />
    <main>
      <slot />
    </main>
  </body>
</html>
