---
import Header from './Header.astro';
import SubTabs from './SubTabs.astro';
import '../styles/theme.css';

interface Props {
  title: string;
  active?: 'wiki' | 'map' | 'enemies' | 'calculator';
}
const { title, active = 'wiki' } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Questbot — {title}</title>
  </head>
  <body>
    <Header />
    <SubTabs active={active} />
    <main>
      <slot />
    </main>
  </body>
</html>
